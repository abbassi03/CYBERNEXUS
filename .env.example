# Copy to .env or export these variables in your shell.
# Replace this value before exposing the application outside localhost.
CYBERNEXUS_SECRET_KEY=replace-with-a-long-random-secret
# Optional: required to enable the external event-ingestion endpoint.
CYBERNEXUS_INGEST_KEY=replace-with-a-separate-random-api-key
# Set to 1 only when served over HTTPS behind a trusted reverse proxy.
CYBERNEXUS_COOKIE_SECURE=0
# Optional: change the bootstrap admin password before first startup.
CYBERNEXUS_ADMIN_PASSWORD=ChangeThisTemporaryPassword123
